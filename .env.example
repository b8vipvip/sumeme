# ============================================================
# SuMeMe production configuration
# Docker --env-file does not remove quotes. Do not quote values.
# ============================================================

APP_DOMAIN=sumeme.mv3.cn
APP_URL=https://sumeme.mv3.cn
LOBE_PORT=3210
GATEWAY_PORT=8010

# Image pins. Upgrade only after CI and GHS production verification.
LOBEHUB_IMAGE=lobehub/lobehub:latest
# LETTA_IMAGE_PIN intentionally uses a new key so an old LETTA_IMAGE=latest value
# cannot override the reviewed runtime during deployment or rollback.
LETTA_IMAGE_PIN=letta/letta:0.16.8
QDRANT_IMAGE=qdrant/qdrant:latest

# ---------------------- Remote AI provider -------------------
# All AI capabilities must use this OpenAI-compatible relay or an approved
# official vendor API. Local model runtimes and local model weights are forbidden.
OPENAI_RELAY_BASE_URL=https://relay.example.com/v1
OPENAI_RELAY_API_KEY=replace_me
OPENAI_CHAT_MODEL=replace_me
OPENAI_MEMORY_MODEL=replace_me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL_LIST=+replace_me
RELAY_TIMEOUT_SECONDS=600
EMBEDDING_TIMEOUT_SECONDS=120

# The internal Provider Proxy can try the relay's native /v1/embeddings endpoint,
# but SuMeMe production pins remote-semantic-hash because the current relay does
# not provide a reliable native endpoint. The remote model extracts semantic tags;
# the proxy performs only deterministic, non-AI hashing locally. No local ML model
# or model weights are used. Use auto/native only after that endpoint is verified.
EMBEDDING_PROVIDER_MODE=remote-semantic-hash
EMBEDDING_SEMANTIC_MODEL=
# 1536 matches the standard text-embedding-3-small Letta handle.
EMBEDDING_DIMENSION=1536
EMBEDDING_MAX_INPUTS=32
EMBEDDING_MAX_CHARS_PER_INPUT=12000

# LobeHub talks only to the memory gateway, never directly to the relay.
GATEWAY_API_KEY=replace_with_random_secret
GATEWAY_ADMIN_TOKEN=replace_with_random_secret
# Dedicated to trusted operational service identities such as production smoke.
# Never expose this token to browsers or LobeHub users.
GATEWAY_SERVICE_TOKEN=replace_with_random_secret
SUMEME_USER_ID=default
MEMORY_RECALL_LIMIT=6
MEMORY_CONTEXT_MAX_CHARS=24000
# Optional memory context must never block the remote chat request indefinitely.
# Recall fails open per component; writes return sanitized timeout error codes.
MEMORY_RECALL_TIMEOUT_SECONDS=20
MEMORY_WRITE_TIMEOUT_SECONDS=180

# ---------------------- Vault storage policy -----------------
# Persistent server-side registry for account + vault ownership and storage mode.
VAULT_REGISTRY_PATH=/data/gateway/vaults.sqlite3
# New vaults default to cloud for backward-compatible server deployments.
# Per-vault modes: local-only, cloud, hybrid.
# local-only: the gateway proxies the chat but performs no server memory read/write.
# cloud: normal MemPalace + Letta/Supermemory recall and automatic persistence.
# hybrid: cloud recall is allowed; raw chat is never auto-persisted. Only an
# explicitly sanitized checkpoint may be written to the cloud memory provider.
DEFAULT_STORAGE_MODE=cloud

# ---------------------- Trusted identity ---------------------
# Modes:
# - legacy-client-asserted: compatibility only
# - trusted-openai-user: trust LobeHub's server-injected OpenAI `user` field
# - jwt-preferred / jwt-required: verify a JWT from non-LobeHub clients
IDENTITY_MODE=legacy-client-asserted
# Stable deployment identifier used with the server-injected user ID. Changing it
# creates new account namespaces, so do not use a hostname that may be renamed.
IDENTITY_TRUSTED_UPSTREAM_ISSUER=lobehub-internal
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
# Configure exactly one JWKS source in a JWT mode. HTTPS URL is preferred.
IDENTITY_JWKS_URL=
# One-line public JWKS JSON only. Never place a private JWK here.
IDENTITY_JWKS_JSON=
IDENTITY_ALLOWED_ALGORITHMS=RS256,ES256,EdDSA
IDENTITY_VAULTS_CLAIM=sumeme_vaults
IDENTITY_DEFAULT_VAULT_CLAIM=sumeme_default_vault
IDENTITY_CLOCK_SKEW_SECONDS=60
IDENTITY_MAX_TOKEN_AGE_SECONDS=3600
IDENTITY_MAX_TOKEN_CHARS=16384
IDENTITY_ALLOW_INSECURE_JWKS_URL=false

# Explicit server-side memory provider switch. There is no automatic provider
# failover or dual write because silent switching can create divergent memories.
# Supported values: mempalace-letta (default), supermemory (backup).
MEMORY_PROVIDER=mempalace-letta

# ---------------------- LobeHub ------------------------------
LOBE_DB_NAME=lobehub
POSTGRES_PASSWORD=replace_with_random_secret
AUTH_SECRET=replace_with_random_secret
KEY_VAULTS_SECRET=replace_with_random_secret
JWKS_KEY=replace_with_generated_jwks_json
AUTH_ALLOWED_EMAILS=
AUTH_DISABLE_EMAIL_PASSWORD=0

# Object storage. The existing LobeHub bucket remains browser-readable until the
# LobeHub attachment path is migrated to signed URLs. New SuMeMe raw/private Vault
# objects must use RUSTFS_PRIVATE_BUCKET, which rustfs-init keeps anonymous=none.
S3_ENDPOINT=https://s3.sumeme.mv3.cn
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
RUSTFS_ACCESS_KEY=sumeme
RUSTFS_SECRET_KEY=replace_with_random_secret
RUSTFS_LOBE_BUCKET=lobe
RUSTFS_PRIVATE_BUCKET=sumeme-vaults

# Scoped object API. The production image enables it, but it refuses normal account
# access while IDENTITY_MODE=legacy-client-asserted. Use trusted-openai-user or a
# verified JWT before exposing private object URLs to account traffic.
OBJECT_API_ENABLED=true
OBJECT_REGISTRY_PATH=/data/gateway/objects.sqlite3
OBJECT_MAX_SIZE_BYTES=2147483648
OBJECT_PRESIGN_TTL_SECONDS=600
OBJECT_ALLOW_INSECURE_PUBLIC_ENDPOINT=false
RUSTFS_INTERNAL_ENDPOINT=http://rustfs:9000
# Optional override; otherwise the gateway reuses S3_ENDPOINT for signed URLs.
RUSTFS_PUBLIC_ENDPOINT=
RUSTFS_REGION=us-east-1

# ---------------------- MemPalace semantics ------------------
# SuMeMe preserves MemPalace wing/room/verbatim-drawer semantics while replacing
# its local ONNX embedding implementation. Full drawers are stored in gateway-data
# SQLite; vectors and scope metadata are stored in Qdrant. Embeddings are obtained
# from the internal Provider Proxy, which itself uses only the relay or an approved
# official API.
MEMPALACE_ENABLED=true
MEMPALACE_QDRANT_URL=http://qdrant:6333
MEMPALACE_QDRANT_NAMESPACE=sumeme
MEMPALACE_REMOTE_DB_PATH=/data/gateway/mempalace-remote.sqlite3
MEMPALACE_EMBEDDING_MAX_CHARS=12000
MEMPALACE_QDRANT_TIMEOUT_SECONDS=30
MEMPALACE_RECALL_LIMIT=6

# ---------------------- Letta --------------------------------
LETTA_ENABLED=true
# false means MemPalace is the required durable write and Letta is an observable
# optional structured-memory component. Letta failures still return component=false,
# degraded=true and stable letta_* error codes. Set true after compatibility is
# verified in production.
LETTA_REQUIRED=false
LETTA_BASE_URL=http://letta:8283
LETTA_SERVER_PASSWORD=replace_with_random_secret
LETTA_ENCRYPTION_KEY=replace_with_random_secret
LETTA_AGENT_ID=
LETTA_AGENT_NAME=sumeme-personal-memory
# The production Compose contract passes openai/<OPENAI_MEMORY_MODEL> explicitly to
# the gateway. The OpenAI-compatible endpoint remains the internal Provider Proxy.
LETTA_MODEL=openai/replace_me
LETTA_EMBEDDING=openai/text-embedding-3-small
LETTA_TIMEOUT_SECONDS=180

# ---------------------- Supermemory backup -------------------
# Point this at the SuMeMe-maintained Supermemory fork or another compatible
# deployment. The fork must route every model/embedding/OCR/vision/transcription
# request to the relay or an approved official API.
SUPERMEMORY_BASE_URL=
SUPERMEMORY_API_KEY=
SUPERMEMORY_DOCUMENTS_PATH=/v3/documents
SUPERMEMORY_SEARCH_PATH=/v4/search
SUPERMEMORY_CONTAINER_PREFIX=sumeme
SUPERMEMORY_SEARCH_MODE=hybrid
SUPERMEMORY_SEARCH_THRESHOLD=0.6
SUPERMEMORY_RERANK=false
SUPERMEMORY_TIMEOUT_SECONDS=180

# ---------------------- Reliability --------------------------
# off: skip production smoke tests
# warn: record critical failures but keep the release active
# required: a critical smoke failure rolls back the application release
SMOKE_TEST_MODE=warn
SMOKE_MEMORY_ATTEMPTS=4
SMOKE_MEMORY_DELAY_SECONDS=12
# Defaults inherit RELAY_TIMEOUT_SECONDS; explicit values must be 30-1800 seconds.
SMOKE_CHAT_TIMEOUT_SECONDS=600
SMOKE_MEMORY_TIMEOUT_SECONDS=600
# A synchronous required-component write is always required. Optional component
# failures are visible as degraded. Semantic recall can be eventually consistent,
# so it is reported as degraded by default rather than rolling back an otherwise
# healthy release. Set true after production latency is measured and stable.
SMOKE_REQUIRE_RECALL=false

# Deployments trigger safe cleanup at the warning threshold and are blocked at
# the failure threshold or when free space is below DISK_MIN_FREE_GIB.
DISK_WARN_PERCENT=80
DISK_FAIL_PERCENT=90
DISK_MIN_FREE_GIB=3
KEEP_RELEASES=5
DOCKER_PRUNE_UNTIL=168h

# ---------------------- Logging ------------------------------
LOG_LEVEL=INFO
STORE_ASSISTANT_VERBATIM=true
